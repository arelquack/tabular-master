{
  "id": "nlp_gemastik_final",
  "name": "NLP Text Classification",
  "description": "Text / NLP case normalized from cases/kredivo/kredivo_reviews_50k.csv. Text: content, Target: sentiment",
  "train_path": "cases/nlp_gemastik_final/train.csv",
  "test_path": "",
  "id_col": "reviewId",
