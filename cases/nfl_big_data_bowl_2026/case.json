{
    "id": "nfl_big_data_bowl_2026",
    "name": "NFL Big Data Bowl 2026",
    "description": "Predicting future NFL player movement trajectories (x, y) using kinematics and GBDT regression.",
    "train_path": "cases/nfl_big_data_bowl_2026/train_tabular.csv",
    "test_path": "cases/nfl_big_data_bowl_2026/test_tabular.csv",
    "auxiliary_paths": [],
    "id_col": "id",
    "target_col": "target_x",
    "group_col": "play_id",
    "task_type": "regression",
    "eval_metric": "rmse",
    "cv_strategy": "group_kfold",
    "n_splits": 5,
    "seed": 2026,
    "models": [
        "lgbm",
        "xgb"
    ],
    "output_dir": "experiments/nfl_run",
    "architecture_preset": "standard",
    "model_params": {
        "lgbm": {
            "n_estimators": 2500,
            "learning_rate": 0.04,
            "num_leaves": 63,
            "colsample_bytree": 0.8
        },
        "xgb": {
            "n_estimators": 2500,
            "learning_rate": 0.04,
            "max_depth": 6,
            "colsample_bytree": 0.8
        }
    }
}
