{
    "id": "airline_s6e10",
    "name": "Airline Passenger Satisfaction (s6e10)",
    "description": "Kaggle Playground Series s6e10 binary classification on passenger satisfaction.",
    "train_path": "playground-series/playground-series-s6e10/train.csv",
    "test_path": "playground-series/playground-series-s6e10/test.csv",
    "auxiliary_paths": [
        "playground-series/playground-series-s6e10/original.csv"
    ],
    "id_col": "id",
    "target_col": "satisfaction",
    "task_type": "binary",
    "eval_metric": "roc_auc",
    "cv_strategy": "stratified_kfold",
    "n_splits": 5,
    "seed": 2026,
    "models": [
        "lgbm",
        "xgb",
        "catboost"
    ],
    "output_dir": "experiments/s6e10_champion_run",
    "model_params": {
        "lgbm": {
            "num_leaves": 4,
            "max_depth": 3,
            "learning_rate": 0.04,
            "n_estimators": 5000,
            "min_child_samples": 100,
            "colsample_bytree": 0.5,
            "subsample": 0.8
        },
        "xgb": {
            "max_depth": 2,
            "learning_rate": 0.04,
            "n_estimators": 5000,
            "min_child_weight": 20,
            "colsample_bytree": 0.5,
            "subsample": 0.8
        },
        "catboost": {
            "depth": 3,
            "learning_rate": 0.05,
            "iterations": 4000,
            "l2_leaf_reg": 5.0
        }
    },
    "architecture_preset": "shallow"
}